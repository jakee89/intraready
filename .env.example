INTRASTAT_PORT=8088
# Required only until the first platform-owner account is created.
INTRASTAT_BOOTSTRAP_TOKEN=replace-with-a-long-random-setup-code
# Set true only after HTTPS is working at the public address.
INTRASTAT_AUTH_COOKIE_SECURE=false
# Create at https://platform.openai.com/api-keys and keep it secret.
INTRASTAT_OPENAI_API_KEY=
INTRASTAT_OPENAI_MODEL=gpt-5.6-terra
